{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thearchitector.dev/xvalidations/schema.json",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "https://thearchitector.dev/xvalidations/vocab/x-validations": true
  },
  "title": "X-Validations Draft 2020-12 dialect",
  "type": "object",
  "allOf": [
    { "$ref": "https://json-schema.org/draft/2020-12/schema" },
    {
      "if": { "required": ["x-validations"] },
      "then": {
        "required": ["$schema"],
        "properties": {
          "$schema": {
            "const": "https://thearchitector.dev/xvalidations/schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "$schema": {
            "const": "https://thearchitector.dev/xvalidations/schema.json"
          }
        },
        "required": ["$schema"]
      },
      "then": { "required": ["x-validations"] }
    }
  ],
  "properties": {
    "x-validations": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "x-constants": false
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "target", "assert"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "target": { "type": "string", "pattern": "^\\$" },
        "assert": { "$ref": "#/$defs/assertion" }
      },
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "required": ["$path"],
      "properties": {
        "$path": { "type": "string", "pattern": "^\\$" }
      },
      "additionalProperties": false
    },
    "pathOrNumber": {
      "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/path" }]
    },
    "pathOrNonNegativeInteger": {
      "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/path" }]
    },
    "pathOrString": {
      "anyOf": [{ "type": "string" }, { "$ref": "#/$defs/path" }]
    },
    "pathOrBoolean": {
      "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/path" }]
    },
    "typeName": {
      "enum": [
        "null",
        "boolean",
        "object",
        "array",
        "number",
        "string",
        "integer"
      ]
    },
    "typeValue": {
      "anyOf": [
        { "$ref": "#/$defs/typeName" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/typeName" },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "pathOrTypeValue": {
      "anyOf": [{ "$ref": "#/$defs/typeValue" }, { "$ref": "#/$defs/path" }]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "pathOrStringArray": {
      "anyOf": [{ "$ref": "#/$defs/stringArray" }, { "$ref": "#/$defs/path" }]
    },
    "dependentRequired": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/stringArray" }
    },
    "pathOrDependentRequired": {
      "anyOf": [
        { "$ref": "#/$defs/dependentRequired" },
        { "$ref": "#/$defs/path" }
      ]
    },
    "assertionArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nestedAssertion" },
      "minItems": 1
    },
    "uniqueByAssertion": {
      "type": "object",
      "required": ["x-uniqueBy"],
      "properties": {
        "x-uniqueBy": { "type": "string", "pattern": "^\\$" }
      },
      "additionalProperties": false
    },
    "draftAssertion": {
      "type": "object",
      "properties": {
        "allOf": { "$ref": "#/$defs/assertionArray" },
        "anyOf": { "$ref": "#/$defs/assertionArray" },
        "oneOf": { "$ref": "#/$defs/assertionArray" },
        "not": { "$ref": "#/$defs/nestedAssertion" },
        "if": { "$ref": "#/$defs/nestedAssertion" },
        "then": { "$ref": "#/$defs/nestedAssertion" },
        "else": { "$ref": "#/$defs/nestedAssertion" },
        "contains": { "$ref": "#/$defs/nestedAssertion" },
        "type": { "$ref": "#/$defs/pathOrTypeValue" },
        "const": true,
        "enum": {
          "anyOf": [
            { "type": "array", "minItems": 1 },
            { "$ref": "#/$defs/path" }
          ]
        },
        "multipleOf": {
          "anyOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "$ref": "#/$defs/path" }
          ]
        },
        "maximum": { "$ref": "#/$defs/pathOrNumber" },
        "exclusiveMaximum": { "$ref": "#/$defs/pathOrNumber" },
        "minimum": { "$ref": "#/$defs/pathOrNumber" },
        "exclusiveMinimum": { "$ref": "#/$defs/pathOrNumber" },
        "maxLength": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "minLength": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "pattern": { "$ref": "#/$defs/pathOrString" },
        "maxItems": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "minItems": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "uniqueItems": { "$ref": "#/$defs/pathOrBoolean" },
        "maxContains": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "minContains": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "maxProperties": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "minProperties": { "$ref": "#/$defs/pathOrNonNegativeInteger" },
        "required": { "$ref": "#/$defs/pathOrStringArray" },
        "dependentRequired": { "$ref": "#/$defs/pathOrDependentRequired" }
      },
      "additionalProperties": false
    },
    "nestedAssertion": {
      "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/draftAssertion" }]
    },
    "assertion": {
      "anyOf": [
        { "type": "boolean" },
        { "$ref": "#/$defs/uniqueByAssertion" },
        { "$ref": "#/$defs/draftAssertion" }
      ]
    }
  }
}
